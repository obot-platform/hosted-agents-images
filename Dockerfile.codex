# The OpenAI Codex CLI, configured to run as an Obot hosted agent.
#
# wolfi-base for the reasons in Dockerfile.claude-code.
FROM cgr.dev/chainguard/wolfi-base:latest@sha256:0a8fd427de5882aed77471b0a432c3675eda6b6a0ae952b5d640b46da628cdbe

# The Codex release; see Dockerfile.claude-code.
ARG AGENT_VERSION=0.146.0
ARG TARGETARCH

# Node 24 and Python 3.12 as general tooling agents shell out to. bubblewrap is
# what Codex sandboxes the commands it runs; it needs an unconfined seccomp
# profile to create a namespace, which a Kubernetes pod provides.
RUN apk add --no-cache \
        bubblewrap \
        bash \
        ca-certificates \
        curl \
        git \
        jq \
        less \
        nodejs-24 \
        npm \
        python-3.12 \
        py3.12-pip \
        ripgrep \
        shadow

# The official released binary, pinned to the version -- no npm. The Linux
# builds are static musl, so they run on this glibc base; the release tag is
# rust-v<version>.
RUN case "${TARGETARCH:-amd64}" in \
        amd64) triple=x86_64-unknown-linux-musl ;; \
        arm64) triple=aarch64-unknown-linux-musl ;; \
        *) echo "unsupported arch ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL -o /tmp/codex.tar.gz \
        "https://github.com/openai/codex/releases/download/rust-v${AGENT_VERSION}/codex-${triple}.tar.gz" \
    && tar -xzf /tmp/codex.tar.gz -C /tmp \
    && install -D -m 0755 "/tmp/codex-${triple}" /usr/local/bin/codex \
    && rm -rf /tmp/codex.tar.gz "/tmp/codex-${triple}"

RUN useradd --create-home --shell /bin/bash agent \
    && mkdir -p /workspace \
    && chown agent:agent /workspace

COPY lib/obot-agent.sh /usr/local/lib/obot-agent.sh
COPY codex/entrypoint.sh /usr/local/bin/obot-entrypoint
RUN chmod 0755 /usr/local/lib/obot-agent.sh /usr/local/bin/obot-entrypoint

USER agent
WORKDIR /workspace
ENV OBOT_AGENT_WORKSPACE=/workspace
ENTRYPOINT ["/usr/local/bin/obot-entrypoint"]
