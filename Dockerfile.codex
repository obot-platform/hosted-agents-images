# The OpenAI Codex CLI, configured to run as an Obot hosted agent.
FROM node:26-bookworm-slim@sha256:9e6f9357d371591e32ab6f2d8a26d63bdd0d17c29eee3f4f3e7e454d9634bf73

# The Codex release to install; see Dockerfile.claude-code for how this is set.
ARG AGENT_VERSION=0.146.0

# bubblewrap is what Codex sandboxes the commands it runs in. Without it Codex
# either refuses to execute anything or falls back to running unsandboxed,
# depending on version -- and an agent executing model-directed commands is
# exactly where a sandbox is worth having.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bubblewrap \
        ca-certificates \
        curl \
        git \
        jq \
        less \
        ripgrep \
    && rm -rf /var/lib/apt/lists/*

# The npm that ships in the base image bundles its own dependencies, and
# several carry fixable advisories. Upgrading it first replaces them.
RUN npm install -g npm@12.0.2 \
    && npm install -g "@openai/codex@${AGENT_VERSION}" \
    && npm cache clean --force

RUN useradd --create-home --shell /bin/bash agent \
    && mkdir -p /workspace \
    && chown agent:agent /workspace

COPY lib/obot-agent.sh /usr/local/lib/obot-agent.sh
COPY codex/entrypoint.sh /usr/local/bin/obot-entrypoint
RUN chmod 0755 /usr/local/lib/obot-agent.sh /usr/local/bin/obot-entrypoint

USER agent
WORKDIR /workspace
ENV OBOT_AGENT_WORKSPACE=/workspace

ENTRYPOINT ["/usr/local/bin/obot-entrypoint"]
