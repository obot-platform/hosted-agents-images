# A Google Agent Development Kit runtime, served over HTTP for Obot's port
# option. The agent it runs is cloned from the repository its template points
# at; this image is only the runtime.
#
# wolfi-base for the reasons in Dockerfile.claude-code.
FROM cgr.dev/chainguard/wolfi-base:latest@sha256:003627df3c1e1bba0c4116afcddb314aca9594ee2328c7e876a8081a6c988b2e

# The google-adk release; see Dockerfile.claude-code for how this is set. The
# mcp extra rather than a bare mcp pin, because ADK declares the range it works
# with and installing mcp directly picked up a version outside it.
ARG AGENT_VERSION=2.6.1

# Python 3.12, plus bash for the entrypoint, git to clone the agent, jq for the
# config, and shadow for useradd.
RUN apk add --no-cache \
        bash \
        ca-certificates \
        git \
        jq \
        python-3.12 \
        py3.12-pip \
        shadow

WORKDIR /app
COPY adk/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir --break-system-packages \
        "google-adk[mcp]==${AGENT_VERSION}" -r /app/requirements.txt

COPY lib/obot-agent.sh /usr/local/lib/obot-agent.sh
COPY adk/entrypoint.sh /usr/local/bin/obot-entrypoint
RUN chmod 0755 /usr/local/lib/obot-agent.sh /usr/local/bin/obot-entrypoint

RUN useradd --create-home --shell /bin/bash agent \
    && mkdir -p /workspace \
    && chown -R agent:agent /workspace /app

USER agent
ENV OBOT_AGENT_WORKSPACE=/workspace \
    PYTHONUNBUFFERED=1

EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/obot-entrypoint"]
