# Claude Code, configured to run as an Obot hosted agent.
FROM node:22-bookworm-slim@sha256:f32b81066cde10a75dbac96646099533316d94bac4150c55da1636e1f0ffdc46

# The Claude Code release to install. images.yaml is the source of truth; the
# default here is only so a bare `docker build` works. The publish workflow
# always passes the value from the manifest, so the two cannot drift.
ARG AGENT_VERSION=2.1.220

# git for the user's repository, jq for the agent config, ripgrep because
# Claude Code shells out to it for search.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        jq \
        less \
        ripgrep \
    && rm -rf /var/lib/apt/lists/*

# The npm that ships in the base image bundles its own dependencies, and
# several carry fixable advisories. Upgrading it first replaces them.
RUN npm install -g npm@12.0.2 \
    && npm install -g "@anthropic-ai/claude-code@${AGENT_VERSION}" \
    # The npm package is a launcher; the program itself is a native binary its
    # installer fetches. Running that here puts it in the image, so a sandbox
    # starts without reaching the network and runs the version pinned above.
    # Left to first run it would download as the agent user, into a directory
    # owned by root, in a pod that may have no egress.
    && node /usr/local/lib/node_modules/@anthropic-ai/claude-code/install.cjs \
    && npm cache clean --force

# A non-root user: an agent runs model-directed commands, and root in the
# container is a larger blast radius than this needs.
RUN useradd --create-home --shell /bin/bash agent \
    && mkdir -p /workspace \
    && chown agent:agent /workspace

COPY lib/obot-agent.sh /usr/local/lib/obot-agent.sh
COPY claude-code/entrypoint.sh /usr/local/bin/obot-entrypoint
RUN chmod 0755 /usr/local/lib/obot-agent.sh /usr/local/bin/obot-entrypoint

USER agent
WORKDIR /workspace
ENV OBOT_AGENT_WORKSPACE=/workspace

ENTRYPOINT ["/usr/local/bin/obot-entrypoint"]
