# Claude Code, configured to run as an Obot hosted agent.
#
# wolfi-base: minimal, continuously rebuilt to carry no known vulnerabilities,
# and glibc -- which the Claude Code native binary requires. Pinned by digest;
# dependabot keeps it current.
FROM cgr.dev/chainguard/wolfi-base:latest@sha256:003627df3c1e1bba0c4116afcddb314aca9594ee2328c7e876a8081a6c988b2e

# The Claude Code release; images.yaml is the source of truth, this default is
# only for a bare `docker build`.
ARG AGENT_VERSION=2.1.220

# Node 24 (Active LTS) and Python 3.12 are here as general tooling: agents
# commonly shell out to them, independent of what Claude Code itself needs.
# git, jq, ripgrep, bash round out what the CLI and the entrypoint use.
RUN apk add --no-cache \
        bash \
        ca-certificates \
        curl \
        git \
        jq \
        less \
        nodejs-24 \
        npm \
        python-3.12 \
        py3.12-pip \
        ripgrep \
        shadow

# A non-root user: an agent runs model-directed commands, and root is a larger
# blast radius than this needs. Claude Code is installed as that user, so its
# launcher and binary land in the home directory it will actually run from.
RUN useradd --create-home --shell /bin/bash agent \
    && mkdir -p /workspace \
    && chown agent:agent /workspace
USER agent

# The official installer, pinned to the version. It downloads the native binary
# and sets up the launcher under ~/.local/bin -- no npm, and no launcher stub
# that fetches the real binary on first run. Done at build time so a sandbox
# starts offline at the pinned version.
ENV PATH=/home/agent/.local/bin:$PATH
RUN curl -fsSL https://claude.ai/install.sh | bash -s "${AGENT_VERSION}"

COPY --chown=agent:agent lib/obot-agent.sh /usr/local/lib/obot-agent.sh
COPY --chown=agent:agent claude-code/entrypoint.sh /usr/local/bin/obot-entrypoint
USER root
RUN chmod 0755 /usr/local/lib/obot-agent.sh /usr/local/bin/obot-entrypoint
USER agent

WORKDIR /workspace
ENV OBOT_AGENT_WORKSPACE=/workspace
ENTRYPOINT ["/usr/local/bin/obot-entrypoint"]
